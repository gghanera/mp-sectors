#the mod name as displayed in-game
displayName: "MP Sectors"

#internal name
name: "mp-sectors"

author: "GGhanera"

#the fully qualified main class
main: "mpsectors.MpSectorsMod"

description: "Runs one campaign sector per server instance, with a shared campaign folder (sector saves, sector info, research). Server-side only. Part of the multi-sector campaign setup."

version: "0.4.0"

#minimum game build required
minGameVersion: 160

#hidden mods are excluded from the mod list compared on connect,
#so players with a vanilla client can join the sector servers
hidden: true

java: true

