#the mod name as displayed in-game
displayName: "MP Campaign"

#internal name
name: "mp-campaign"

author: "GGhanera"

#the fully qualified main class
main: "mpcampaign.MpCampaignMod"

description: "Coordinator client: shows the campaign sector map and lands on sectors. Talks to the mp-sectors coordinator over HTTP; install on every player."

version: "2.2.2"

#minimum game build required
minGameVersion: 160

java: true

